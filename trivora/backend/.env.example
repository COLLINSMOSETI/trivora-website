# Copy this file to ".env" (inside the backend folder) and fill it in.
# Never share or upload the real .env file.

# ---- Admin account (created the first time the backend runs) ----
# If ADMIN_PASSWORD is empty, a random password is generated and printed in the terminal once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Email notifications (optional but recommended) ----
# Sends an email to trivoratechnologies1@gmail.com whenever someone fills in the contact form.
# Use a Gmail "App password" (NOT your normal Gmail password):
#   Google Account -> Security -> 2-Step Verification (turn on) -> App passwords -> create one for "Mail".
SMTP_USER=trivoratechnologies1@gmail.com
SMTP_PASSWORD=
NOTIFY_TO=trivoratechnologies1@gmail.com
# Send the customer an automatic "we received your request" email (1 = yes, 0 = no)
SEND_AUTOREPLY=1

# ---- Server ----
PORT=5000

# ---- How the frontend connects ----
# 1 = this backend also serves the ../frontend folder (one command runs everything)
# 0 = API only; host the frontend elsewhere and list its address(es) in CORS_ORIGINS
SERVE_FRONTEND=1
# Websites allowed to call this API when the frontend is hosted separately (comma separated, no trailing slash)
# Example: https://trivora.co.ke,https://www.trivora.co.ke
CORS_ORIGINS=

# ---- Live deployment ----
# Set to 1 if the backend runs behind a proxy/host (Render, Nginx, Cloudflare) so real visitor IPs are logged
TRUST_PROXY=0
# Optional: fixed secret key for admin tokens (otherwise one is generated and saved in backend/data/)
SECRET_KEY=
# Optional: where the database and secret key are stored (use a persistent disk in production)
# TRIVORA_DB=/data/trivora.db
